{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "moduleResolution": "bundler",
    "paths": {
      "@environment/*": ["./src/environments/*"],
      "@resolvers/*": ["./src/app/features/resolvers/*"],
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@components/*": ["./src/app/features/components/*"],
      "@stores/*": ["./src/app/features/stores/*"],
      "@services/*": ["./src/app/features/services/*"],
      "@pages/*": ["./src/app/features/pages/*"],
      "@models/*": ["./src/app/features/models/*"],
      "@interfaces/*": ["./src/app/features/interfaces/*"],
      "@interceptors/*": ["./src/app/features/interceptors/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
