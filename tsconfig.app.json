{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "moduleResolution": "bundler",
    "paths": {
      "@environments/*": ["./src/environments/*"],
      // "@components/*": ["./src/app/features/components/*"],
      "@components": ["./src/app/features/components/index.ts"],
      // "@interceptors/*": ["./src/app/features/interceptors/*"],
      "@interceptors": ["./src/app/features/interceptors/index.ts"],
      // "@interfaces/*": ["./src/app/shared/interfaces/*"],
      "@interfaces": ["./src/app/shared/interfaces/index.ts"],
      // "@types/*": ["./src/app/shared/types/*"],
      "@types": ["./src/app/shared/types/index.ts"],
      // "@pages/*": ["./src/app/features/pages/*"],
      "@pages": ["./src/app/features/pages/index.ts"],
      // "@resolvers/*": ["./src/app/features/resolvers/*"],
      "@resolvers": ["./src/app/features/resolvers/index.ts"],
      // "@services/*": ["./src/app/features/services/*"],
      "@services": ["./src/app/features/services/index.ts"],
      // "@stores/*": ["./src/app/features/stores/*"],
      "@stores": ["./src/app/features/stores/index.ts"],
      "@forms": ["./src/app/features/forms/index.ts"],
      // "@forms/*": ["./src/app/features/forms/*"],

      // "@buttons/*": ["./src/app/shared/buttons/*"],
      "@buttons": ["./src/app/shared/buttons/index.ts"],
      // "@inputs/*": ["./src/app/shared/inputs/*"],
      "@inputs": ["./src/app/shared/inputs/index.ts"],
      // "@modals/*": ["./src/app/shared/modals/*"],
      "@modals": ["./src/app/shared/modals/index.ts"],
      // "@loading/*": ["./src/app/shared/loading/*"],
      "@loading": ["./src/app/shared/loading/index"],
      // "@pipes/*": ["./src/app/shared/pipes/*"],
      "@pipes": ["./src/app/shared/pipes/index.ts"],
      // "@utils/*": ["./src/app/shared/utils/*"],
      "@utils": ["./src/app/shared/utils/index.ts"],
      // "@errors/*": ["./src/app/shared/errors/*"],
      "@errors": ["./src/app/shared/errors/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
